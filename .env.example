# Copy to .dev.vars (wrangler / workerd reads it in `bun run dev`).
#   cp .env.example .dev.vars
# Production: `wrangler secret put <NAME>` for each secret below.

NODE_ENV="development"

# Nicrron model gateway (OpenAI-compatible). Keys look like sk-af-...
NICRRON_API_KEY=""
NICRRON_BASE_URL="https://api.nicrron.ai/v1"
# Routing preset (nicrron/auto | fastest | cheapest | reasoning | coding) or a concrete model.
NICRRON_MODEL="nicrron/auto"
